# Settings for `docker compose up`. Copy to .env and fill in; .env is not committed.
#
#   cp .env.example .env

# --- Required ----------------------------------------------------------------------------------

# Signs the API's access tokens. Whoever knows it can sign in as anyone.
#   openssl rand -base64 48
AURORA_JWT_SIGNING_KEY=

# Password of Aurora's own metadata database (not of the databases it manages).
# Letters and digits only: it is used inside a connection string.
#   openssl rand -hex 24
AURORA_SYSTEM_DB_PASSWORD=

# --- First start only --------------------------------------------------------------------------

# The first administrator. Created once, while no administrator exists; ignored afterwards.
# Remove both after the first start, and preferably change the password in Aurora.
AURORA_ADMIN_USERNAME=admin
# 12 to 128 characters.
AURORA_ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------------------------

# Where Aurora listens on this machine.
AURORA_BIND=127.0.0.1
AURORA_PORT=8080

# Leave false for plain HTTP on localhost. Behind a TLS-terminating reverse proxy set it to true,
# and add the proxy to Security__TrustedProxies__0 in docker-compose.yml (docs/security.md).
AURORA_HTTPS=false

# Where new backups go: local (a Docker volume) or s3.
AURORA_BACKUP_STORAGE=local
AURORA_S3_BUCKET=
AURORA_S3_REGION=
AURORA_S3_ENDPOINT=
AURORA_S3_ACCESS_KEY=
AURORA_S3_SECRET_KEY=
AURORA_S3_PATH_STYLE=false
