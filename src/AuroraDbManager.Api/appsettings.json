{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jobs": {
    "MaxConcurrency": 2,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 1,
    "LeaseDurationSeconds": 60,
    "LeaseRenewalIntervalSeconds": 20
  },
  "Docker": {
    "Endpoint": "",
    "NetworkName": "aurora-db",
    "ReadinessTimeoutSeconds": 120,
    "ReadinessPollIntervalMilliseconds": 1000
  },
  "Databases": {
    "ConnectTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 60
  },
  "Backups": {
    "StorageType": "local",
    "Local": {
      "RootPath": "/var/lib/aurora/backups"
    },
    "S3": {
      "Bucket": "",
      "Region": "",
      "Endpoint": "",
      "PathStyle": false,
      "Prefix": "",
      "StagingPath": "",
      "UploadTimeoutSeconds": 3600
    },
    "Tools": {
      "PgDumpPath": "pg_dump",
      "MySqlDumpPath": "mysqldump",
      "PgRestorePath": "pg_restore",
      "MySqlPath": "mysql"
    },
    "Restore": {
      "StagingPath": "",
      "TimeoutSeconds": 21600,
      "LockTimeoutSeconds": 60
    },
    "TimeoutSeconds": 3600,
    "ConnectTimeoutSeconds": 10
  }
}
