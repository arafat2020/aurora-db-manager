<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The application itself: services, domain, infrastructure and the REST API all live there. -->
    <ProjectReference Include="..\AuroraDbManager.Api\AuroraDbManager.Api.csproj" />
  </ItemGroup>

  <!--
    Both hosts have settings files of the same names. This host is published with its own; the
    API project's copies, which come along with the project reference, are left out.
  -->
  <Target Name="PublishOwnSettingsOnly" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings')) And $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('AuroraDbManager.Api'))" />
    </ItemGroup>
  </Target>

</Project>
