@page "/error/{code:int?}"
@model ErrorModel
@{
    Layout = User.IsSignedIn() ? "_Layout" : "_BareLayout";
    ViewData["Title"] = Model.Title;
}
<div class="state" role="alert">
    <partial name="_Icon" model="@Model.Icon" />
    <p class="error-code">@Model.Status</p>
    <h1>@Model.Title</h1>
    <p class="state-message">@Model.Message</p>
    @if (Model.RetryAfterSeconds is { } seconds)
    {
        <p class="state-message">Try again in @seconds second@(seconds == 1 ? "" : "s").</p>
    }
    <p class="state-action">
        @if (User.IsSignedIn())
        {
            <a class="button" href="~/">Back to the overview</a>
        }
        else
        {
            <a class="button" href="~/login">Sign in</a>
        }
    </p>
    <p class="request-id">Request ID: <span class="mono">@Model.RequestId</span></p>
</div>
