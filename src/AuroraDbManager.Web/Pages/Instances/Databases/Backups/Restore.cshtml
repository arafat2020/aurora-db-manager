@page "/instances/{id:guid}/databases/{databaseId:guid}/backups/{backupId:guid}/restore"
@model AuroraDbManager.Web.Pages.Instances.Databases.Backups.RestoreModel
@using AuroraDbManager.Api.Domain.Backups
@{
    var instance = Model.Instance;
    var database = Model.Database;
    var backup = Model.Backup;
    var created = DateTime.SpecifyKind(backup.CreatedAt, DateTimeKind.Utc).ToString("yyyy-MM-dd HH:mm") + " UTC";
    ViewData["Title"] = $"Restore {database.Name}";
    var header = new PageHeader("Restore database?", $"{database.Name} · in {instance.Name}")
    {
        Breadcrumbs =
        [
            new Crumb("Instances", Routes.Instances), new Crumb(instance.Name, Routes.Instance(instance.Id)),
            new Crumb("Databases", Routes.Databases(instance.Id)), new Crumb(database.Name, Routes.Database(instance.Id, database.Id)),
            new Crumb("Backups", Routes.Backups(instance.Id, database.Id)), new Crumb(created, Routes.Backup(instance.Id, database.Id, backup.Id)),
            new Crumb("Restore")
        ],
        Status = StatusBadge.For(database.Status)
    };
}
<partial name="_PageHeader" model="@header" />

@if (Model.Problem is not null)
{
    <partial name="_Alert" model="@Model.Problem" />
}
else if (backup.Status != BackupStatus.Completed)
{
    <partial name="_Alert" model="@(new Alert(StatusTone.Warning, "Only a completed backup can be restored.", $"This backup is {StatusBadge.For(backup.Status).Label.ToLowerInvariant()}"))" />
}

<div class="card card-danger form-card">
    <div class="card-body stack">
        <dl class="definition-list">
            <dt>Database</dt>
            <dd><strong class="mono">@database.Name</strong> <span class="muted">in @instance.Name, @Labels.For(instance.Engine) @instance.Version</span></dd>
            <dt>Backup</dt>
            <dd><partial name="_Time" model="@((DateTime?)backup.CreatedAt)" /> <partial name="_StatusBadge" model="@StatusBadge.For(backup.Status)" /></dd>
            <dt>Backup ID</dt>
            <dd class="mono">@backup.Id</dd>
            <dt>Size</dt>
            <dd>
                @if (backup.SizeBytes is { } size)
                {
                    @Labels.Size(size)
                }
                else
                {
                    <span class="muted">Not available</span>
                }
            </dd>
            <dt>Storage</dt>
            <dd>@Labels.For(backup.StorageType)</dd>
            <dt>Integrity</dt>
            <dd>
                @if (StatusBadge.ForIntegrity(backup) is { } integrity)
                {
                    <partial name="_StatusBadge" model="@integrity" />
                }
                else
                {
                    <span class="muted">Not available</span>
                }
            </dd>
        </dl>
        <p><strong>Restoring this backup replaces the current contents of the database <span class="mono">@database.Name</span>.</strong></p>
        <ul class="consequences">
            <li>Everything in the database now is removed. Tables, data and other objects created or changed since <partial name="_Time" model="@((DateTime?)backup.CreatedAt)" /> are lost.</li>
            <li>This cannot be undone through Aurora, unless another backup exists that holds the current data. If you may need it, create a backup first.</li>
            <li>Clients connected to the database are disconnected, and the database may be unavailable while the restore is performed.</li>
            <li>The backup is fetched and checked against its recorded size@(backup.Checksum is not null ? " and checksum" : " and format; it has no recorded checksum") before anything in the database is changed. If the restore fails after that, the database may be left empty or partly restored; restoring again repairs that.</li>
        </ul>
        <form method="post" class="form">
            <div class="form-actions">
                <a class="button" href="@Url.Content("~" + Routes.Backup(instance.Id, database.Id, backup.Id))">Cancel</a>
                <button type="submit" class="button button-danger-solid" data-busy-label="Starting the restore…">Restore database</button>
            </div>
        </form>
    </div>
</div>
