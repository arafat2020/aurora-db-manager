@page "/instances/{id:guid}/databases/{databaseId:guid}/schedule/delete"
@model AuroraDbManager.Web.Pages.Instances.Databases.Schedule.DeleteModel
@{
    var instance = Model.Instance;
    var database = Model.Database;
    var schedule = Model.Schedule;
    ViewData["Title"] = $"Delete backup schedule · {database.Name}";
    var header = new PageHeader("Delete backup schedule?", $"{database.Name} · in {instance.Name}")
    {
        Breadcrumbs =
        [
            new Crumb("Instances", Routes.Instances), new Crumb(instance.Name, Routes.Instance(instance.Id)),
            new Crumb("Databases", Routes.Databases(instance.Id)), new Crumb(database.Name, Routes.Database(instance.Id, database.Id)),
            new Crumb("Backup schedule", Routes.Schedule(instance.Id, database.Id)), new Crumb("Delete")
        ],
        Status = StatusBadge.ForEnabled(schedule.Enabled)
    };
}
<partial name="_PageHeader" model="@header" />

<div class="card card-danger form-card">
    <div class="card-body stack">
        <dl class="definition-list">
            <dt>Database</dt>
            <dd><strong class="mono">@database.Name</strong> <span class="muted">in @instance.Name</span></dd>
            <dt>Cron</dt>
            <dd><code>@schedule.CronExpression</code></dd>
            <dt>Time zone</dt>
            <dd class="mono">@schedule.TimeZoneId</dd>
            <dt>Next run</dt>
            <dd>
                @if (schedule.NextRunAt is not null)
                {
                    <partial name="_Time" model="@schedule.NextRunAt" />
                }
                else
                {
                    <span>Disabled</span>
                }
            </dd>
        </dl>
        <p>This removes the backup schedule of the database <strong class="mono">@database.Name</strong>.</p>
        <ul class="consequences">
            <li><strong>Automatic backups of this database stop.</strong> It is backed up only when someone asks for a backup.</li>
            <li>Backups that exist are kept, and a backup that is running now is not stopped.</li>
            <li>The database itself is not affected. A new schedule can be created afterwards.</li>
            <li>To pause the schedule and keep it, disable it instead.</li>
        </ul>
        <form method="post" class="form">
            <div class="form-actions">
                <a class="button" href="@Url.Content("~" + Routes.Schedule(instance.Id, database.Id))">Cancel</a>
                <button type="submit" class="button button-danger-solid" data-busy-label="Deleting…">Delete schedule</button>
            </div>
        </form>
    </div>
</div>
