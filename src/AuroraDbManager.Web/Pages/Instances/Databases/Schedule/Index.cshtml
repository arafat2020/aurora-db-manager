@page "/instances/{id:guid}/databases/{databaseId:guid}/schedule"
@model AuroraDbManager.Web.Pages.Instances.Databases.Schedule.IndexModel
@{
    var instance = Model.Instance;
    var database = Model.Database;
    var schedule = Model.Schedule;
    ViewData["Title"] = $"Backup schedule · {database.Name}";
    var create = schedule is null && Offered.CreateSchedule(User, instance, database)
        ? new PageAction("Create schedule", Routes.EditSchedule(instance.Id, database.Id))
        : null;
    var header = new PageHeader("Backup schedule", $"When the database {database.Name}, in {instance.Name}, is backed up by itself.", create)
    {
        Breadcrumbs =
        [
            new Crumb("Instances", Routes.Instances), new Crumb(instance.Name, Routes.Instance(instance.Id)),
            new Crumb("Databases", Routes.Databases(instance.Id)), new Crumb(database.Name, Routes.Database(instance.Id, database.Id)),
            new Crumb("Backup schedule")
        ],
        Status = schedule is null ? null : StatusBadge.ForEnabled(schedule.Enabled)
    };
}
<partial name="_PageHeader" model="@header" />

@if (schedule is null)
{
    <partial name="_EmptyState" model="@(new EmptyState("No backup schedule configured", create is not null
        ? "Create a schedule to automatically back up this database."
        : User.IsOperator() ? "A schedule can be created once the database is ready and its instance is running." : "An operator or an administrator creates it.", "schedules", create))" />
}
else
{
    <section class="section" aria-labelledby="schedule-title">
        <div class="section-header">
            <h2 id="schedule-title">Schedule</h2>
            @if (Offered.ChangeSchedule(User))
            {
                <span class="section-actions">
                    <a class="button" href="@Url.Content("~" + Routes.EditSchedule(instance.Id, database.Id))">Edit schedule</a>
                    <form method="post" asp-page="./Edit" asp-page-handler="@(schedule.Enabled ? "Disable" : "Enable")" asp-route-id="@instance.Id" asp-route-databaseId="@database.Id">
                        <button type="submit" class="button" data-busy-label="Saving…">@(schedule.Enabled ? "Disable schedule" : "Enable schedule")</button>
                    </form>
                    <a class="button button-danger" href="@Url.Content("~" + Routes.DeleteSchedule(instance.Id, database.Id))">Delete schedule</a>
                </span>
            }
        </div>
        <div class="card">
            <div class="card-body">
                <dl class="definition-list">
                    <dt>Database</dt>
                    <dd><a class="mono" href="@Url.Content("~" + Routes.Database(instance.Id, database.Id))">@database.Name</a> <span class="muted">in @instance.Name, @Labels.For(instance.Engine) @instance.Version</span></dd>
                    <dt>Schedule</dt>
                    <dd>
                        <partial name="_StatusBadge" model="@StatusBadge.ForEnabled(schedule.Enabled)" />
                        <span class="muted">@(schedule.Enabled ? "The database is backed up at every occurrence of the expression below." : "Kept, but nothing is backed up by it until it is enabled again.")</span>
                    </dd>
                    <dt>Cron</dt>
                    <dd><code>@schedule.CronExpression</code> <span class="muted">minute, hour, day of month, month, day of week</span></dd>
                    <dt>Time zone</dt>
                    <dd><span class="mono">@schedule.TimeZoneId</span> <span class="muted">The expression is read on the clock of this time zone.</span></dd>
                    <dt>Next run</dt>
                    <dd>
                        @if (schedule.NextRunAt is { } nextRun)
                        {
                            <partial name="_Time" model="@((DateTime?)nextRun)" />
                            @if (Labels.InZone(nextRun, schedule.TimeZoneId) is { } local)
                            {
                                <span class="muted">which is @local in @schedule.TimeZoneId</span>
                            }
                        }
                        else
                        {
                            <span>Disabled</span>
                            <span class="muted">A disabled schedule has no next run.</span>
                        }
                    </dd>
                    <dt>Created</dt>
                    <dd><partial name="_Time" model="@((DateTime?)schedule.CreatedAt)" /></dd>
                    <dt>Last updated</dt>
                    <dd><partial name="_Time" model="@((DateTime?)schedule.UpdatedAt)" /> <span class="muted">Also when it last moved on to its next run.</span></dd>
                    <dt>ID</dt>
                    <dd class="mono">@schedule.Id</dd>
                </dl>
            </div>
        </div>
    </section>

    <p class="table-note">
        A backup the schedule causes is an ordinary backup: it appears among the database's
        <a href="@Url.Content("~" + Routes.Backups(instance.Id, database.Id))">backups</a> and its
        <a href="@Url.Content("~" + Routes.JobsOfDatabase(database.Id))">jobs</a> like one that was asked for by hand, and goes to the storage this server is configured with.
        An occurrence that finds the database busy or unavailable is skipped; occurrences missed while Aurora was down are made up for by one backup.
    </p>
}
