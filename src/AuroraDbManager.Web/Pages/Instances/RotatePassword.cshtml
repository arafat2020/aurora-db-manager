@page "/instances/{id:guid}/rotate-password"
@model AuroraDbManager.Web.Pages.Instances.RotatePasswordModel
@using AuroraDbManager.Api.Application.Credentials
@using AuroraDbManager.Api.Domain.Instances
@{
    var instance = Model.Instance;
    var credential = Model.Credential;
    ViewData["Title"] = $"Rotate password · {instance.Name}";
    var header = new PageHeader("Rotate database password?", $"{instance.Name} · {Labels.For(instance.Engine)} {instance.Version}")
    {
        Breadcrumbs = [new Crumb("Instances", Routes.Instances), new Crumb(instance.Name, Routes.Instance(instance.Id)), new Crumb("Rotate password")],
        Status = StatusBadge.For(instance.Status)
    };
}
<partial name="_PageHeader" model="@header" />

@if (Model.Problem is not null)
{
    <partial name="_Alert" model="@Model.Problem" />
}
else if (instance.Status != InstanceStatus.Running)
{
    <partial name="_Alert" model="@(new Alert(StatusTone.Warning, "The password can only be rotated while the instance is running.", $"The instance is {StatusBadge.For(instance.Status).Label.ToLowerInvariant()}"))" />
}
else if (credential.Rotation == CredentialRotationState.InProgress)
{
    <partial name="_Alert" model="@(new Alert(StatusTone.Warning, "The password of this instance is already being rotated.", "A rotation is in progress"))" />
}
else if (credential.Rotation == CredentialRotationState.Incomplete)
{
    <partial name="_Alert" model="@(new Alert(StatusTone.Warning, "The last rotation failed before the new password took effect everywhere. Rotating now finishes it with the password that was generated then.", "The last rotation did not finish"))" />
}

<div class="card card-danger form-card">
    <div class="card-body stack">
        <p>This replaces the password of <strong class="mono">@credential.Username</strong>, the database administrator of <strong>@instance.Name</strong>, with a new one that Aurora generates.</p>
        <ul class="consequences">
            <li><strong>The current password stops working</strong> once the rotation has succeeded. Applications and people that connect as <span class="mono">@credential.Username</span> with it can no longer connect.</li>
            <li><strong>The new password is shown once</strong>, on request, after the rotation has succeeded, to an operator or an administrator, and for a limited time. Aurora stores it encrypted and uses it for its own work: creating and deleting databases, backups and restores.</li>
            <li>Connections that are open at that moment stay open. The database server is not restarted, and no data is touched.</li>
            <li>The work is done in the background. Its job says whether it succeeded, and is where the new password is asked for.</li>
        </ul>
        <form method="post" class="form">
            <div class="form-actions">
                <a class="button" href="@Url.Content("~" + Routes.Instance(instance.Id))">Cancel</a>
                <button type="submit" class="button button-danger-solid" data-busy-label="Starting…">Rotate password</button>
            </div>
        </form>
    </div>
</div>
