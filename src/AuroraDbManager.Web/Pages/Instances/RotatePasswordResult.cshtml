@page "/instances/{id:guid}/rotate-password/{jobId:guid}/result"
@model AuroraDbManager.Web.Pages.Instances.RotatePasswordResultModel
@{
    var instance = Model.Instance;
    ViewData["Title"] = $"New password · {instance.Name}";
    var header = new PageHeader(Model.Result is null ? "New password" : "Password rotated successfully", $"{instance.Name} · {Labels.For(instance.Engine)} {instance.Version}")
    {
        Breadcrumbs = [new Crumb("Instances", Routes.Instances), new Crumb(instance.Name, Routes.Instance(instance.Id)), new Crumb("New password")],
        Status = StatusBadge.For(instance.Status)
    };
}
<partial name="_PageHeader" model="@header" />

@if (Model.Problem is not null)
{
    <partial name="_Alert" model="@Model.Problem" />
    <p class="table-note"><a href="@Url.Content("~" + Routes.Job(Model.JobId))">Back to the rotation's job</a> · <a href="@Url.Content("~" + Routes.Instance(instance.Id))">Back to the instance</a></p>
}
else if (Model.Result is { } result)
{
    @* The one response that has the password. It is not in the address, a field or a script, and this page is never served again with it. *@
    <partial name="_Alert" model="@(new Alert(StatusTone.Warning, "Store it securely before leaving this page. Aurora will not display it again; reloading this page does not bring it back.", "This password will only be shown once"))" />
    <div class="card form-card">
        <div class="card-body stack">
            <dl class="definition-list">
                <dt>Username</dt>
                <dd class="mono">@result.Username</dd>
                <dt>New password</dt>
                <dd>
                    <div class="copy">
                        <code class="snippet" id="new-password">@result.Password</code>
                        <button type="button" class="button" data-copy="#new-password" hidden>Copy password</button>
                    </div>
                </dd>
            </dl>
            <p class="muted">The previous password no longer works. Aurora keeps this one encrypted for its own work; nothing else needs to be done for backups, restores or database operations.</p>
            <div class="form-actions">
                <a class="button button-primary" href="@Url.Content("~" + Routes.Instance(instance.Id))">Done</a>
            </div>
        </div>
    </div>
}
