@model DatabaseTable
<div class="table-wrap">
    <table class="table">
        <caption>Databases of @Model.Instance.Name, newest first</caption>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Status</th>
                <th scope="col">Created</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var database in Model.Databases)
            {
                <tr>
                    <td class="cell-primary"><a href="@Url.Content("~" + Routes.Database(Model.Instance.Id, database.Id))">@database.Name</a></td>
                    <td>
                        <partial name="_StatusBadge" model="@StatusBadge.For(database.Status)" />
                        @if (database.Error is not null)
                        {
                            <code>@database.Error.Code</code>
                        }
                    </td>
                    <td><partial name="_Time" model="@((DateTime?)database.CreatedAt)" /></td>
                    <td class="cell-actions">
                        <a class="button button-quiet" href="@Url.Content("~" + Routes.Database(Model.Instance.Id, database.Id))">Open<span class="visually-hidden"> @database.Name</span></a>
                        @if (Offered.DeleteDatabase(User, Model.Instance, database))
                        {
                            <a class="button button-quiet button-danger" href="@Url.Content("~" + Routes.DeleteDatabase(Model.Instance.Id, database.Id))">Delete<span class="visually-hidden"> @database.Name</span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
