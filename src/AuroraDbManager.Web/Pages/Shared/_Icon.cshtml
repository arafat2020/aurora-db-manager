@model string
@* Line icons, drawn inline so they take the colour of the text around them and need no request.
   Decorative: the text next to an icon says what it means. *@
<svg class="icon @(Model == "brand" ? "brand-mark" : null)" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "brand":
        case "databases":
            <ellipse cx="12" cy="6" rx="8" ry="3" />
            <path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6" />
            <path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
            break;
        case "overview":
            <rect x="3" y="3" width="7" height="9" rx="1" />
            <rect x="14" y="3" width="7" height="5" rx="1" />
            <rect x="14" y="12" width="7" height="9" rx="1" />
            <rect x="3" y="16" width="7" height="5" rx="1" />
            break;
        case "instances":
            <rect x="3" y="4" width="18" height="7" rx="1.5" />
            <rect x="3" y="13" width="18" height="7" rx="1.5" />
            <path d="M7 7.5h.01M7 16.5h.01" />
            break;
        case "backups":
            <rect x="3" y="4" width="18" height="5" rx="1" />
            <path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9" />
            <path d="M10 13h4" />
            break;
        case "schedules":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "jobs":
            <path d="M8 6h13M8 12h13M8 18h13" />
            <path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01" />
            break;
        case "monitoring":
            <path d="M3 12h4l3-8 4 16 3-8h4" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5" />
            <path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.9c1.6.9 2.7 2.6 3 5.1" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c.8-4 4-6.5 8-6.5s7.2 2.5 8 6.5" />
            break;
        case "signout":
            <path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" />
            <path d="M16 8l4 4-4 4M20 12H9" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9" rx="1.5" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="M16 16l4.5 4.5" />
            break;
        case "success":
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12.5l2.8 2.8L16 9.5" />
            break;
        case "progress":
            <path d="M21 12a9 9 0 1 1-9-9" />
            <path d="M12 7v5l3 2" />
            break;
        case "neutral":
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12h8" />
            break;
        case "warning":
            <path d="M12 3.5L22 20H2L12 3.5z" />
            <path d="M12 10v4.5M12 17.5h.01" />
            break;
        case "danger":
            <circle cx="12" cy="12" r="9" />
            <path d="M9 9l6 6M15 9l-6 6" />
            break;
        default:
            <path d="M4 13l2-8h12l2 8" />
            <path d="M4 13v5a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5h-5a3 3 0 0 1-6 0H4z" />
            break;
    }
</svg>
