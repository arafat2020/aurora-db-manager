@model AuroraDbManager.Api.Application.Jobs.JobListResponse
@* The last few background operations on one instance or database. The Jobs section has them all. *@
<div class="table-wrap">
    <table class="table">
        <caption>Most recent operations, newest first</caption>
        <thead>
            <tr>
                <th scope="col">Operation</th>
                <th scope="col">Status</th>
                <th scope="col">Attempt</th>
                <th scope="col">Created</th>
                <th scope="col">Finished</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.Items)
            {
                <tr>
                    <td class="cell-primary">@Labels.For(job.Type)</td>
                    <td>
                        <partial name="_StatusBadge" model="@StatusBadge.For(job.Status)" />
                        @if (job.Error is not null)
                        {
                            <code>@job.Error.Code</code>
                        }
                    </td>
                    <td>@job.Attempt of @job.MaxAttempts</td>
                    <td><partial name="_Time" model="@((DateTime?)job.CreatedAt)" /></td>
                    <td><partial name="_Time" model="@job.CompletedAt" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>
